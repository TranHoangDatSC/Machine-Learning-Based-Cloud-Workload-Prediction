# Khong dung "data/raw/**" vi no loai ca THU MUC, khien moi dong "!" phia sau
# vo tac dung — git khong the dua lai mot tep khi thu muc cha da bi loai.
data/raw/**/*.csv
data/raw/**/*.zip
data/raw/**/*.gz
data/raw/**/*.tar
data/raw/**/*.parquet
data/interim/**
data/processed/**
data/features/**
